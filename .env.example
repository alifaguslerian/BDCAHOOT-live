# BDCAHOOT Live Arena - Environment Template
# Duplicate this file to .env or .env.local for local configuration.
# Never commit .env or any file containing real credentials to Git!

# Server port (default 3000)
PORT=3000

# Environment mode
NODE_ENV=development

# GEMINI_API_KEY: Optional - Required only if server-side AI quiz generation is used.
GEMINI_API_KEY=""

# APP_URL: Base URL of the application
APP_URL="http://localhost:3000"
