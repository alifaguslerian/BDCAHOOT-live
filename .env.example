# BDCAHOOT Live Arena - Environment Template
# Duplicate this file to .env or .env.local for local configuration.
# Never commit .env or any file containing real credentials to Git!

# Server port (default 3000)
PORT=3000

# Environment mode
NODE_ENV=development

# Optional fixed operator key (at least 12 characters). When empty, server prints a random key.
# Keep this on the Host laptop; never use NEXT_PUBLIC_HOST_KEY.
HOST_KEY=""

# APP_URL: Base URL of the application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
